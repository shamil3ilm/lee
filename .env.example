NODE_ENV=development

# Database
DATABASE_URL=postgres://user:pass@host:5432/employ

# Auth.js
AUTH_SECRET=                          # openssl rand -hex 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL=http://localhost:3000
ALLOWED_EMAIL=you@example.com

# AI — optional server DEFAULTS. Each user can pick the model and save their
# own Gemini / Groq / Firecrawl / Laya keys in Settings › AI; saved values win.
# Options: gemini (Google, generous free tier but rate-limited)
#          groq (Llama 3.3 70B, 30 req/min free, best open-source alternative)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Self-hosted model via Ollama (no key; prompts stay on that machine). Set the
# URL to offer "Ollama · Local model" in Settings › AI, or AI_PROVIDER=ollama
# to make it the default. Pull the model first: `ollama pull qwen2.5:7b`.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_TIMEOUT_MS=180000
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional
FIRECRAWL_API_KEY=

# Google Picker ("Attach from Drive"). Public, browser-side config, inlined at
# build time. Optional: the button is hidden when unset. See README
# "Google Drive file storage" for the console steps.
# NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=       # referrer-restricted API key
# NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER= # Cloud project number (Picker app id)

# Cron
CRON_SECRET=                          # openssl rand -hex 32
