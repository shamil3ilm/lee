NODE_ENV=development

# Database
DATABASE_URL=postgres://user:pass@host:5432/employ

# Auth.js
AUTH_SECRET=                          # openssl rand -hex 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL=http://localhost:3000
ALLOWED_EMAIL=you@example.com

# AI — optional server DEFAULTS. Each user can pick the model and save their
# own Gemini / Groq / Firecrawl / Laya keys in Settings › AI; saved values win.
# Options: gemini (Google, generous free tier but rate-limited)
#          groq (Llama 3.3 70B, 30 req/min free, best open-source alternative)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional
FIRECRAWL_API_KEY=

# Cron
CRON_SECRET=                          # openssl rand -hex 32
